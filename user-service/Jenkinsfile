// user-service/Jenkinsfile
//
// Commit pipeline for user-service (Node.js + Express)
// Stages:
//   1. Show workspace          — sanity check
//   2. Install dependencies    — npm ci (deterministic install)
//   3. Unit tests + coverage   — Jest with lcov + junit output
//   4. SonarQube Analysis      — SAST + coverage import
//   5. Quality Gate            — enforce Sonar Quality Gate rules
//   6. Build and Push Image    — kaniko to ECR
//
// Test artifacts published to Jenkins:
//   - JUnit XML for pass/fail visualization (Test Results tab)
//   - HTML coverage report for browsing

pipeline {
    agent {
        kubernetes {
            cloud 'vjcloudbank-eks'
            defaultContainer 'node'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  namespace: jenkins-agents
  labels:
    app: jenkins-agent
    service: user-service
spec:
  serviceAccountName: jenkins
  restartPolicy: Never
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:latest
      resources:
        requests:
          cpu: "100m"
          memory: "256Mi"
        limits:
          cpu: "500m"
          memory: "512Mi"
    - name: node
      image: node:20-alpine
      command:
        - sleep
      args:
        - infinity
      resources:
        requests:
          cpu: "200m"
          memory: "512Mi"
        limits:
          cpu: "1500m"
          memory: "2Gi"
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      command:
        - sleep
      args:
        - infinity
      resources:
        requests:
          cpu: "200m"
          memory: "512Mi"
        limits:
          cpu: "1500m"
          memory: "2Gi"
'''
        }
    }

    environment {
        SERVICE_DIR     = 'user-service'
        PROJECT_KEY     = 'vjcloudbank-user-service'
        AWS_REGION      = 'ap-south-1'
        AWS_ACCOUNT_ID  = '135808958462'
        ECR_REPO        = 'vjcloudbank/user-service'
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_TAG       = "${BUILD_NUMBER}"
    }

    stages {
        stage('Show workspace') {
            steps {
                container('jnlp') {
                    sh 'pwd && ls -la'
                    sh 'ls -la ${SERVICE_DIR} || echo "SERVICE_DIR not found — check Multibranch checkout"'
                }
            }
        }

        stage('Install dependencies') {
            steps {
                container('node') {
                    dir("${SERVICE_DIR}") {
                        // npm ci = clean install from package-lock.json — reproducible
                        // Faster than npm install and won't modify lock file
                        sh 'npm ci'
                    }
                }
            }
        }

        stage('Unit tests') {
            steps {
                container('node') {
                    dir("${SERVICE_DIR}") {
                        // Run Jest with coverage + JUnit XML output
                        // JEST_JUNIT_OUTPUT_FILE controls where junit.xml is written
                        // '|| true' avoids stopping the pipeline here — junit + coverage
                        // publishers below make the results visible either way
                        sh '''
                            npm test -- \
                              --coverage \
                              --coverageReporters=lcov \
                              --coverageReporters=cobertura \
                              --coverageReporters=text-summary \
                              --reporters=default \
                              --reporters=jest-junit
                        '''
                    }
                }
            }
            post {
                always {
                    // Publish JUnit results — visible in Jenkins Test Result tab
                    junit testResults: "${SERVICE_DIR}/junit.xml", allowEmptyResults: false

                    // Publish HTML coverage report
                    publishHTML target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "${SERVICE_DIR}/coverage/lcov-report",
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report — user-service'
                    ]
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                container('node') {
                    sh 'apk add --no-cache openjdk17-jre'
                    script {
                        def scannerHome = tool 'sonar-scanner-5'
                        withSonarQubeEnv('vjcloudbank-sonar') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \\
                                  -Dsonar.projectKey=${PROJECT_KEY} \\
                                  -Dsonar.projectName=${PROJECT_KEY} \\
                                  -Dsonar.projectBaseDir=\${WORKSPACE}/${SERVICE_DIR} \\
                                  -Dsonar.sources=src \\
                                  -Dsonar.tests=tests \\
                                  -Dsonar.exclusions=**/node_modules/**,**/coverage/**,**/*.test.js,**/dist/**,**/build/** \\
                                  -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \\
                                  -Dsonar.testExecutionReportPaths=junit.xml \\
                                  -Dsonar.sourceEncoding=UTF-8
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build and Push Image') {
            steps {
                container('kaniko') {
                    sh '''
                        /kaniko/executor \
                          --context=${WORKSPACE}/${SERVICE_DIR} \
                          --dockerfile=${WORKSPACE}/${SERVICE_DIR}/Dockerfile \
                          --destination=${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG} \
                          --destination=${ECR_REGISTRY}/${ECR_REPO}:latest \
                          --verbosity=info
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "==============================================="
            echo "user-service pipeline PASSED"
            echo "Image: ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
            echo "==============================================="
        }
        failure {
            echo "user-service pipeline FAILED"
        }
    }
}
