pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/vijeshcloudops/vjcloudbank.git'
        SERVICE_DIR = 'user-service'
        PROJECT_KEY = 'vjcloudbank-user-service'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
    
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: "${REPO_URL}",
                    credentialsId: 'github-pat-vjcloudbank'
                sh 'ls -la ${SERVICE_DIR}'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'sonar-scanner-5'
                    withSonarQubeEnv('vjcloudbank-sonar') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \\
                              -Dsonar.projectKey=${PROJECT_KEY} \\
                              -Dsonar.projectName=${PROJECT_KEY} \\
                              -Dsonar.projectBaseDir=${WORKSPACE}/${SERVICE_DIR} \\
                              -Dsonar.sources=. \\
                              -Dsonar.exclusions=**/node_modules/**,**/coverage/**,**/*.test.js,**/dist/**,**/build/** \\
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline passed. Dashboard: http://vjcloudbank-cicd-alb-71340887.ap-south-1.elb.amazonaws.com:9000/dashboard?id=${PROJECT_KEY}"
        }
        failure {
            echo "Pipeline failed. Check whether it broke on the scan or the quality gate."
        }
    }
}