{
  "info": {
    "name": "VjCloudBank SIT Smoke",
    "description": "Post-deployment smoke tests for SIT environment.\n\nTests validate:\n1. All service health endpoints reachable\n2. Full user journey: register → login → create account → deposit → history\n\nRuns as part of Jenkinsfile.sit-deploy after ArgoCD sync completes.\nOwned by QA team (as SIT DevOps SPOC I wire it into the pipeline).\n\nUsage:\n  newman run vjcloudbank-sit-smoke.postman_collection.json \\\n    --environment environments/sit.postman_environment.json \\\n    --reporters cli,junit \\\n    --reporter-junit-export newman-results.xml",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "testUserEmail",
      "value": ""
    },
    {
      "key": "testUserPassword",
      "value": "SitTest2026!"
    },
    {
      "key": "jwtToken",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "API Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API Gateway returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "User Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User service reachable', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Account Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Account service reachable', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Transaction Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Transaction service reachable', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User Journey",
      "item": [
        {
          "name": "Setup - Generate test user email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique email per test run to avoid conflicts",
                  "const timestamp = Date.now();",
                  "const randomSuffix = Math.floor(Math.random() * 10000);",
                  "const email = `sit-test-${timestamp}-${randomSuffix}@vjcloudbank.test`;",
                  "pm.collectionVariables.set('testUserEmail', email);",
                  "console.log('Generated test user email:', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup completed', function () {",
                  "    const email = pm.collectionVariables.get('testUserEmail');",
                  "    pm.expect(email).to.include('@vjcloudbank.test');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Register new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"full_name\": \"SIT Smoke Test User\",\n    \"email\": \"{{testUserEmail}}\",\n    \"password\": \"{{testUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User registered - status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains user data', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data).to.have.property('id');",
                  "    pm.expect(body.data.email).to.eql(pm.collectionVariables.get('testUserEmail'));",
                  "});",
                  "pm.test('Password hash not exposed', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.password_hash).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login and capture JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{testUserEmail}}\",\n    \"password\": \"{{testUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful - status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('JWT token returned', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.token).to.be.a('string');",
                  "    pm.expect(body.data.token.split('.').length).to.eql(3);",
                  "    // Capture the JWT for subsequent requests",
                  "    pm.collectionVariables.set('jwtToken', body.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create account with initial deposit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"account_type\": \"savings\",\n    \"currency\": \"INR\",\n    \"description\": \"SIT smoke test account\",\n    \"initial_deposit\": 5000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Account created - status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Account data returned', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data.account_number).to.be.a('string');",
                  "    pm.expect(body.data.currency).to.eql('INR');",
                  "    // Capture account ID for transaction tests",
                  "    pm.collectionVariables.set('accountId', body.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List my accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('List accounts - status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('At least one account returned', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.count).to.be.at.least(1);",
                  "    pm.expect(body.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Deposit to account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"accountId\": \"{{accountId}}\",\n    \"amount\": 1500.00,\n    \"description\": \"SIT smoke test deposit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "deposit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Deposit successful - status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Transaction details returned', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data.type).to.eql('DEPOSIT');",
                  "    pm.expect(parseFloat(body.data.amount)).to.eql(1500.00);",
                  "});",
                  "pm.test('Balance increased correctly (5000 + 1500 = 6500)', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(parseFloat(body.data.balanceAfter)).to.eql(6500.00);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "View transaction history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/history/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "history", "{{accountId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('History returned - status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('History contains the deposit', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data).to.be.an('array');",
                  "    pm.expect(body.data.length).to.be.at.least(1);",
                  "    const deposit = body.data.find(t => t.type === 'DEPOSIT');",
                  "    pm.expect(deposit).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
