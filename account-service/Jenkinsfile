// account-service/Jenkinsfile
//
// Commit pipeline for account-service (Python + FastAPI)
// Stages:
//   1. Show workspace
//   2. Install dependencies    — prod + dev requirements
//   3. Unit tests + coverage   — pytest with coverage.xml + junit.xml
//   4. SonarQube Analysis      — with Python coverage import
//   5. Quality Gate
//   6. Build and Push Image    — kaniko to ECR

pipeline {
    agent {
        kubernetes {
            cloud 'vjcloudbank-eks'
            defaultContainer 'python'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  namespace: jenkins-agents
  labels:
    app: jenkins-agent
    service: account-service
spec:
  serviceAccountName: jenkins
  restartPolicy: Never
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:latest
      resources:
        requests:
          cpu: "100m"
          memory: "256Mi"
        limits:
          cpu: "500m"
          memory: "512Mi"
    - name: python
      image: python:3.12-slim
      command:
        - sleep
      args:
        - infinity
      resources:
        requests:
          cpu: "200m"
          memory: "512Mi"
        limits:
          cpu: "1500m"
          memory: "2Gi"
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      command:
        - sleep
      args:
        - infinity
      resources:
        requests:
          cpu: "200m"
          memory: "512Mi"
        limits:
          cpu: "1500m"
          memory: "2Gi"
'''
        }
    }

    environment {
        SERVICE_DIR     = 'account-service'
        PROJECT_KEY     = 'vjcloudbank-account-service'
        AWS_REGION      = 'ap-south-1'
        AWS_ACCOUNT_ID  = '135808958462'
        ECR_REPO        = 'vjcloudbank/account-service'
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_TAG       = "${BUILD_NUMBER}"
    }

    stages {
        stage('Show workspace') {
            steps {
                container('jnlp') {
                    sh 'pwd && ls -la'
                    sh 'ls -la ${SERVICE_DIR} || echo "SERVICE_DIR not found"'
                }
            }
        }

        stage('Install dependencies') {
            steps {
                container('python') {
                    dir("${SERVICE_DIR}") {
                        sh '''
                            python -m pip install --upgrade pip
                            pip install -r requirements.txt
                            pip install -r requirements-dev.txt
                        '''
                    }
                }
            }
        }

        stage('Unit tests') {
            steps {
                container('python') {
                    dir("${SERVICE_DIR}") {
                        // pytest args come from pytest.ini
                        // Outputs: junit.xml, coverage.xml, htmlcov/
                        sh 'pytest'
                    }
                }
            }
            post {
                always {
                    junit testResults: "${SERVICE_DIR}/junit.xml", allowEmptyResults: false

                    publishHTML target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "${SERVICE_DIR}/htmlcov",
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report — account-service'
                    ]
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                container('python') {
                    sh '''
                        apt-get update -qq
                        apt-get install -y --no-install-recommends default-jre-headless
                        rm -rf /var/lib/apt/lists/*
                    '''
                    script {
                        def scannerHome = tool 'sonar-scanner-5'
                        withSonarQubeEnv('vjcloudbank-sonar') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \\
                                  -Dsonar.projectKey=${PROJECT_KEY} \\
                                  -Dsonar.projectName=${PROJECT_KEY} \\
                                  -Dsonar.projectBaseDir=\${WORKSPACE}/${SERVICE_DIR} \\
                                  -Dsonar.sources=app \\
                                  -Dsonar.tests=tests \\
                                  -Dsonar.exclusions=**/__pycache__/**,**/*.pyc,**/.venv/**,**/venv/**,**/env/**,**/tests/** \\
                                  -Dsonar.python.coverage.reportPaths=coverage.xml \\
                                  -Dsonar.python.xunit.reportPath=junit.xml \\
                                  -Dsonar.sourceEncoding=UTF-8 \\
                                  -Dsonar.python.version=3.12
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build and Push Image') {
            steps {
                container('kaniko') {
                    sh '''
                        /kaniko/executor \
                          --context=${WORKSPACE}/${SERVICE_DIR} \
                          --dockerfile=${WORKSPACE}/${SERVICE_DIR}/Dockerfile \
                          --destination=${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG} \
                          --destination=${ECR_REGISTRY}/${ECR_REPO}:latest \
                          --verbosity=info
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "account-service pipeline PASSED. Image: ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo "account-service pipeline FAILED"
        }
    }
}
