# ─────────────────────────────────────────────
# VjCloudBank Account Service - Environment Variables
# ─────────────────────────────────────────────
# Copy this to .env and fill in your values

# Server
PORT=3002
APP_ENV=development

# PostgreSQL — separate DB from user service!
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vjcloudbank_accounts
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret — MUST be the same as User Service
# Both services use the same secret to verify tokens
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
