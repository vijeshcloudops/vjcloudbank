# Never commit these — contains real passwords!
.env
*.env.local

# Maven build output
target/
*.jar
*.war
*.class

# IDE files
.idea/
*.iml
.vscode/
*.classpath
*.project
.settings/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Spring Boot dev tools restart file
.spring-boot-devtools.properties
