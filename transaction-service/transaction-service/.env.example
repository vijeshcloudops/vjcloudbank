# ─────────────────────────────────────────────
# VjCloudBank Transaction Service - Environment Variables
# ─────────────────────────────────────────────
# Copy this to .env and fill in your values
# For local: set these as environment variables in your terminal
# For production: these come from AWS Secrets Manager

# Server
PORT=3003

# PostgreSQL — separate DB from other services!
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vjcloudbank_transactions
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret — MUST be the same as User Service and Account Service!
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
