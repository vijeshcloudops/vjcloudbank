# ─────────────────────────────────────────────
# VjCloudBank Notification Service - Environment Variables
# ─────────────────────────────────────────────

# Server
PORT=3004
NODE_ENV=development

# JWT Secret — same as all other services
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ── AWS Configuration ─────────────────────────
# In production these come from AWS Secrets Manager
# The EC2/EKS instance role handles authentication — no keys needed!
# For local testing, create an IAM user with SES + SNS permissions
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ── AWS SES (Email) ───────────────────────────
# The email address you verified in AWS SES console
SES_FROM_EMAIL=vjcloudbank@yourdomain.com
SES_FROM_NAME=VjCloudBank

# ── AWS SNS (SMS) ─────────────────────────────
# Leave empty — SNS SMS doesn't need a topic ARN for direct sending
SNS_SMS_SENDER_ID=VjCloudBank

# ── Local Development ─────────────────────────
# Set to 'true' to skip real AWS calls and just log to console
# Set to 'false' in production
USE_MOCK_NOTIFICATIONS=true
