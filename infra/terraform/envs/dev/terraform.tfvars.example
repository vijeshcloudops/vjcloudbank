# ==========================================================
# VjCloudBank Terraform Dev Environment - Example tfvars
# ==========================================================
# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit real values.

# Basic project config
aws_region   = "ap-south-1"
environment  = "dev"
project_name = "vjcloudbank"

# ==========================================================
# EKS Addon Versions
# ==========================================================
# Get current versions with:
# aws eks describe-addon-versions --region ap-south-1 \
#   --kubernetes-version 1.34 --addon-name <addon-name> \
#   --query 'addons[0].addonVersions[0].addonVersion'

vpc_cni_version    = "v1.19.0-eksbuild.1"
coredns_version    = "v1.11.4-eksbuild.2"
kube_proxy_version = "v1.34.0-eksbuild.2"
ebs_csi_version    = "v1.35.0-eksbuild.1"

# ==========================================================
# RDS Engine Version
# ==========================================================
# Get current with:
# aws rds describe-db-engine-versions --region ap-south-1 \
#   --engine postgres --query 'DBEngineVersions[?starts_with(EngineVersion, `16.`)].EngineVersion'

db_engine_version = "16.6"

# ==========================================================
# Admin IP for SSH Access
# ==========================================================
# Your public IP with /32 for SSH access to Jenkins/Sonar.
# Get your public IP: curl -s https://checkip.amazonaws.com
# Example format: "203.0.113.42/32"

admin_ip_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"
