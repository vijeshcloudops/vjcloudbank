# ─────────────────────────────────────────────
# VjCloudBank API Gateway - Environment Variables
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# JWT Secret — same as all services
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ── Downstream Service URLs ───────────────────
# Local development — services run on localhost
# Production — services run as Kubernetes ClusterIP services
USER_SERVICE_URL=http://localhost:3001
ACCOUNT_SERVICE_URL=http://localhost:3002
TRANSACTION_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ──────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:5173
